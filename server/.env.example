# Giftyy Backend Configuration
PORT=5000
NODE_ENV=development
APP_NAME=Giftyy
APP_TAGLINE="Skip the gifts. Fund the dream"
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# MongoDB Database URI (supports Atlas, local, or memory-mock mode)
MONGODB_URI=mongodb://localhost:27017/giftyy
USE_IN_MEMORY_DB=true

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_giftyy_2026_dev
JWT_EXPIRES_IN=7d

# AES-256 Data Encryption Key (32-byte hex string for sensitive KYC & audit encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# KYC / ID Verification Provider (Digio, Setu, Cashfree, Signzy, or mock)
KYC_PROVIDER=mock
KYC_API_KEY=mock_kyc_api_key
KYC_API_SECRET=mock_kyc_api_secret
KYC_WEBHOOK_SECRET=mock_kyc_webhook_secret
KYC_DATA_RETENTION_DAYS=180

# Razorpay Configuration (Route / Split settlement enabled)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=webhook_secret_key
RAZORPAY_MOCK_MODE=true

# Platform Fee (0 to 3%, e.g., 0 for zero fee)
PLATFORM_FEE_PERCENT=0

# SMS / OTP Provider (MSG91 or Twilio - Simulated in Dev)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
